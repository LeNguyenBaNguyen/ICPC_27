 right, highlighter, verbose)\n        elif op == \">\":\n            if isset(left) and isset(right):\n                explanation = _compare_gt_set(left, right, highlighter, verbose)\n        elif op == \"<\":\n            if isset(left) and isset(right):\n                explanation = _compare_lt_set(left, right, highlighter, verbose)\n\n    except outcomes.Exit:\n        raise\n    except Exception:\n        repr_crash = _pytest._code.ExceptionInfo.from_current()._getreprcrash()\n        explanation = [\n            f\"(pytest_assertion plugin: representation of details failed: {repr_crash}.\",\n            \" Probably an object has a faulty __repr__.)\",\n        ]\n\n    if not explanation:\n        return None\n\n    if explanation[0] != \"\":\n        explanation = [\"\", *explanation]\n    return [summary, *explanation]\n```\n\nFacts extracted from this version by a parser (tree-sitter):\nsignature: assertrepr_compare(op, left, right, verbose, highlighter) -> list[str] | None\ncalls: _compare_eq_any, _compare_gt_set, _compare_gte_set, _compare_lt_set, _compare_lte_set, _notin_text, _pytest._code.ExceptionInfo.from_current, _pytest._code.ExceptionInfo.from_current()._getreprcrash, isinstance, isset, istext, len, normalize, saferepr, saferepr_unlimited\nreturn statements: return None | return [summary, *explanation]\nraise statements: raise\ncontrol flow: if=10 loops=0 try=1 with=0 returns=2 yields=0 awaits=0\n\nDiff from the previous version to this version:\n```diff\n--- previous\n+++ current\n@@ -1,7 +1,10 @@\n def assertrepr_compare(\n-    config: Config, op: str, left: object, right: object\n+    op: str,\n+    left: object,\n+    right: object,\n+    *,\n+    verbose: int,\n+    highlighter: _HighlightFunc,\n ) -> list[str] | None:\n-    verbose = config.get_verbosity(Config.VERBOSITY_ASSERTIONS)\n-\n     # Strings which normalize equal are often hard to distinguish when printed; use ascii() to make this easier.\n     # See issue #3246.\n@@ -26,5 +29,4 